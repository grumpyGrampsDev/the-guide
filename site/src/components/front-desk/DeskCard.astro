---
interface Props {
  title: string;
  description: string;
  action: string;
  href: string;
}

const {
  title,
  description,
  action,
  href,
} = Astro.props;
---

<article class="desk-card">
  <h2>{title}</h2>

  <p>{description}</p>

  <a href={href}>
    {action} &rsaquo;
  </a>
</article>

<style>
  .desk-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    padding-inline: 2rem;

    text-align: center;
  }

  .desk-card h2 {
    margin: 0;

    font-size: 1.75rem;
    text-align: center;
  }

  .desk-card p {
    margin: 0;

    color: var(--ink-soft);
    line-height: 1.9;
  }

  .desk-card a {
    align-self: center;

    font-family: var(--font-ui);
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .desk-card {
      gap: 1rem;
      padding-inline: 0;
    }

    .desk-card h2 {
      font-size: 1.5rem;
    }
  }
</style>