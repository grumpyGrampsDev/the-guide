---
interface Props {
  shelfHref: string;
  shelfLabel: string;
}

const { shelfHref, shelfLabel } = Astro.props;
---

<nav class="document-navigation" aria-label="Document navigation">
  <a class="back" href={shelfHref}>
    &lsaquo; Back to {shelfLabel}
  </a>

  <a class="library" href="/library">
    Browse the Library &rsaquo;
  </a>
</nav>

<style>
  .document-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 3rem;

    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .document-navigation a {
    color: var(--ink-faint);
    text-decoration: none;

    transition: color 150ms ease;
  }

  .document-navigation a:hover {
    color: var(--link);
  }

  .back {
    font-weight: 500;
  }

  .library {
    font-weight: 400;
  }
</style>