---
interface Props {
  href: string;
  label: string;
}

const {
  href,
  label,
} = Astro.props;
---

<header class="back-link">
  <a href={href}>
    ← {label}
  </a>
</header>

<style>
  .back-link {
    margin-bottom: 2rem;
  }

  .back-link a {
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: #666;
  }

  .back-link a:hover {
    color: #222;
  }
</style>