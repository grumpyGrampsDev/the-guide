---
---

<main class="page">
  <div class="page-content">
    <slot />
  </div>
</main>

<style>
  .page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .page-content {
    width: 100%;
  }

  .page-content > :global(*) {
    max-width: 100%;
  }

  .page-content > :global(:first-child) {
    margin-top: 0;
  }

  .page-content :global(article) > h1:first-child {
    margin: 0 0 2.5rem;
    text-align: center;
    text-wrap: balance;
  }

  .page-content :global(article h2) {
    margin-top: 3.5rem;
  }

  .page-content :global(article h3) {
    margin-top: 2.25rem;
  }

  .page-content :global(.section-heading) {
    margin-top: 4rem;
    text-align: center;
  }
</style>