---
import type {
  GuideLink,
  PutIntoPractice,
  RecommendedNext,
} from "../../lib/librarian";

interface Props {
  putIntoPractice?: PutIntoPractice;
  recommendedNext?: RecommendedNext;
  relatedReading: GuideLink[];
}

const {
  putIntoPractice,
  recommendedNext,
  relatedReading,
} = Astro.props;
---

<footer class="document-footer">

  {
    putIntoPractice && (
      <section>
        <h2 class="section-heading">
          Put It Into Practice
        </h2>

        <p>{putIntoPractice.content}</p>
      </section>
    )
  }

  {
    recommendedNext && (
      <section>
        <h2 class="section-heading">
          Recommended Next Step
        </h2>

        <p>{recommendedNext.description}</p>

        <p>
          <a href={`/library/${recommendedNext.link.slug}`}>
            Continue →
          </a>
        </p>
      </section>
    )
  }

  {
    relatedReading.length > 0 && (
      <section>
        <h2 class="section-heading">
          Related Reading
        </h2>

        <ul>
          {
            relatedReading.map((document) => (
              <li>
                <a href={`/library/${document.slug}`}>
                  {document.title}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

</footer>

<style>
  .document-footer {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid #ddd;
  }

  .document-footer section + section {
    margin-top: 3rem;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .document-footer ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .document-footer li + li {
    margin-top: 0.5rem;
  }
</style>