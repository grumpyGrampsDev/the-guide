---
import Page from "../layout/Page.astro";
import PageNavigation from "../navigation/PageNavigation.astro"
import DocumentFooter from "./footer/DocumentFooter.astro";

import type {
  GuideDocument,
  GuideShelf,
} from "../../lib/librarian";

import DocumentBody from "./DocumentBody.astro";

interface Props {
  document: GuideDocument;
  shelf: GuideShelf;
}

const {
  document,
  shelf,
} = Astro.props;

---

<Page>
  <PageNavigation
    leftHref={`/library/${document.shelf}`}
    leftLabel={`Back to the ${shelf.name} Shelf`}
    rightHref="/library"
    rightLabel="Browse the Library"
  />

  <DocumentBody document={document} />

  <DocumentFooter
    putIntoPractice={document.putIntoPractice}
    recommendedNext={document.recommendedNext}
    relatedReading={document.relatedReading}
  />
</Page>