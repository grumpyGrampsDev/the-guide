---
import type { PutIntoPractice } from "../../../lib/librarian";

interface Props {
  putIntoPractice?: PutIntoPractice;
}

const { putIntoPractice } = Astro.props;
---

{
  putIntoPractice && (
    <section>
      <h2 class="section-heading">
        Put It Into Practice
      </h2>

      <Fragment set:html={putIntoPractice.html} />
    </section>
  )
}

<style>
  .section-heading {
    text-align: center;
    margin-bottom: 1.25rem;
  }
</style>