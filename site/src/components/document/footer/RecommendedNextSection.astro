---
import type { RecommendedNext } from "../../../lib/librarian";

interface Props {
  recommendedNext?: RecommendedNext;
}

const { recommendedNext } = Astro.props;
---

{
  recommendedNext && (
    <section>
      <h2 class="section-heading">
        Recommended Next Step
      </h2>

      <p>{recommendedNext.description}</p>

      <p>
        <a href={`/library/${recommendedNext.link.slug}`}>
          Continue →
        </a>
      </p>
    </section>
  )
}

<style>
  .section-heading {
    text-align: center;
    margin-bottom: 1.25rem;
  }
</style>