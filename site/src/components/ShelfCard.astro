---
import type { GuideShelf } from "../lib/librarian";

interface Props {
  shelf: GuideShelf;
}

const { shelf } = Astro.props;
---

<section>
  <h3>{shelf.name}</h3>

  <p>
    Discover the writings and practices gathered on this shelf.
  </p>

  <a href={`/library/${shelf.slug}`}>
    Go to row
  </a>
</section>