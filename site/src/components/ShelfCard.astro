---
import type { GuideShelf } from "../lib/librarian";

interface Props {
  shelf: GuideShelf;
}

const { shelf } = Astro.props;
---

<section>
  <h3>{shelf.name}</h3>

  <ul>
    {
      shelf.documents.map((document) => (
        <li>
          <a href={`/library/${document.slug}`}>
            {document.title}
          </a>
        </li>
      ))
    }
  </ul>
</section>