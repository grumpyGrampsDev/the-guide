---
import type { GuideShelf } from "../lib/librarian";

interface Props {
  shelf: GuideShelf;
}

const { shelf } = Astro.props;

const bookCount = shelf.documents.length;
---

<section class="shelf-card">
  <h2>{shelf.name}</h2>

  {
    shelf.description && (
      <p class="description">
        {shelf.description}
      </p>
    )
  }

  <p class="count">
    {bookCount} {bookCount === 1 ? "book" : "books"}
  </p>

  <a
    class="browse"
    href={`/library/${shelf.slug}`}
  >
    Browse Shelf →
  </a>
</section>

<style>
  .shelf-card {
    display: flex;
    flex-direction: column;

    gap: 1.5rem;
  }

  .shelf-card h2 {
    margin: 0;

    font-family: var(--font-ui);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .description {
    margin: 0;

    color: var(--ink-soft);
  }

  .count {
    margin: auto 0 0;

    font-size: 0.95rem;
    color: var(--ink-faint);
  }

  .browse {
    align-self: flex-start;

    font-family: var(--font-ui);
    font-weight: 500;

    color: var(--link);
    text-decoration: none;
  }

  .browse:hover {
    text-decoration: underline;
  }
</style>