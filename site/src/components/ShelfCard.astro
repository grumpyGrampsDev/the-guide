---
import type { GuideShelf } from "../lib/librarian";

interface Props {
  shelf: GuideShelf;
}

const { shelf } = Astro.props;
---

<section class="shelf-card">
  <h3>{shelf.name}</h3>

  {
    shelf.description && (
      <p>{shelf.description}</p>
    )
  }

  <p>
    {shelf.documents.length}
    {" "}
    {shelf.documents.length === 1 ? "document" : "documents"}
  </p>


  <a href={`/library/${shelf.slug}`}>
    Browse Shelf →
  </a>
</section>