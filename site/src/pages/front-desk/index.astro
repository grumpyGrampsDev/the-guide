---
import Layout from "../../layouts/Layout.astro";
import DeskCard from "../../components/front-desk/DeskCard.astro";
import { guideUrl } from "../../lib/urls";
---

<Layout title="Front Desk | The Guide">
  <main class="front-desk">
    <header class="welcome">
      <h1>Front Desk</h1>

      <p>Welcome.</p>

      <p>
        The Guide is a companion for reading Scripture with humility, prayer,
        reflection, remembrance, and faithful walking.
      </p>
    </header>

    <section class="desk">
      <DeskCard
        title="First Visit"
        description="Begin with the Introduction to understand the purpose, philosophy, and posture behind The Guide."
        action="Start the Journey"
        href={guideUrl("library/introduction/purpose-of-the-guide")}
      />

      <DeskCard
        title="Browse the Library"
        description="Explore every shelf and every book within The Guide. Read in order, or simply follow your curiosity."
        action="Enter the Library"
        href={guideUrl("library")}
      />
    </section>
  </main>
</Layout>

<style>
  .front-desk {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-bottom: 4rem;
  }

  .welcome {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
  }

  .welcome h1 {
    margin-bottom: 2rem;
  }

  .welcome p {
    color: var(--ink-soft);
  }

  .welcome p:first-of-type {
    margin-bottom: 1rem;

    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 600;

    color: var(--ink);
  }

  .desk {
    position: relative;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 5rem;

    align-items: start;

    padding: 5rem 6rem 0;
  }

  .desk > * {
    max-width: 28rem;
    justify-self: center;
  }

  .desk::before {
    content: "";

    position: absolute;
    top: 0;
    left: 50%;

    transform: translateX(-50%);

    width: 32rem;
    height: 1px;

    background: var(--divider);
    opacity: 0.8;
  }

  @media (max-width: 800px) {
    .desk {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 3rem 1rem 0;
    }

    .desk::before {
      width: min(100%, 20rem);
    }
  }
</style>
