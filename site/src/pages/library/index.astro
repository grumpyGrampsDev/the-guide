---
import Layout from "../../layouts/Layout.astro";
import Page from "../../components/layout/Page.astro";
import LibraryHeader from "../../components/library/LibraryHeader.astro";
import ShelfCard from "../../components/ShelfCard.astro";
import { getLibrary } from "../../lib/librarian";
import { guideUrl } from "../../lib/urls";

const library = await getLibrary();
---

<Layout title="The Library">
  <Page variant="library">

    <nav class="library-navigation" aria-label="Library navigation">
      <a href={guideUrl("front-desk")}>
        &lsaquo; Return to the Front Desk
      </a>
    </nav>

    <LibraryHeader />

    <section class="shelves">
      {
        library.shelves.map((shelf) => (
          <ShelfCard shelf={shelf} />
        ))
      }
    </section>

  </Page>
</Layout>

<style>
  .library-navigation {
    margin-bottom: 3rem;

    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  .library-navigation a {
    color: var(--ink-faint);
    text-decoration: none;

    transition: color 150ms ease;
  }

  .library-navigation a:hover {
    color: var(--link);
  }

  .shelves {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 5rem 4rem;

    margin-top: 5rem;
  }

@media (max-width: 700px) {
  .library-navigation {
    margin-bottom: 2rem;
  }

  .shelves {
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-top: 3rem;
  }
}

</style>