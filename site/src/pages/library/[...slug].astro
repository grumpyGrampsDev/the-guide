---
import Layout from "../../layouts/Layout.astro";
import DocumentPage from "../../components/DocumentPage.astro";

import {
  getLibraryDocuments,
  getDocument,
  getShelf,
} from "../../lib/librarian";


export async function getStaticPaths() {
  const documents = await getLibraryDocuments();

  return documents.map((document) => ({
    params: {
      slug: document.slug,
    },
  }));
}

const { slug } = Astro.params;
const document = await getDocument(slug ?? "");

if (!document) {
  return Astro.redirect("/404");
}

const shelf = await getShelf(document.shelf);

if (!shelf) {
  return Astro.redirect("/404");
}


---

<Layout title={document.title}>
  <DocumentPage
    document={document}
    shelf={shelf}
  />
</Layout>