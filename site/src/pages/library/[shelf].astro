---
import Layout from "../../layouts/Layout.astro";
import { getGuideShelves, getShelf } from "../../lib/librarian";
import DocumentBody from "../../components/document/DocumentBody.astro";
import Page from "../../components/layout/Page.astro";
import PageNavigation from "../../components/navigation/PageNavigation.astro";
import { guideUrl } from "../../lib/urls";

export async function getStaticPaths() {
  const availableShelves = await getGuideShelves();

  return availableShelves.map((shelf) => ({
    params: {
      shelf: shelf.slug,
    },
  }));
}

const { shelf: shelfSlug } = Astro.params;

const currentShelf = await getShelf(shelfSlug ?? "");

if (!currentShelf) {
  return Astro.redirect("/404");
}
---

<Layout title={currentShelf.name}>
  <Page>

  <PageNavigation
    leftHref={guideUrl("library")}
    leftLabel="Browse the Library"
  />

  <section class="shelf">

    {
      currentShelf.readme && (
        <DocumentBody document={currentShelf.readme} />
      )
    }

  </section>

</Page>
</Layout>

<style>
.shelf {
  position: relative;

  padding-top: 2rem;
}

.shelf::before {
  content: "";

  display: block;

  width: 18rem;
  height: 1px;

  margin: 0 auto 3rem;

  background: var(--divider);
}

  .shelf-header {
    margin-bottom: 2rem;
  }

  .shelf-header a {
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: #666;
  }

  .shelf-header a:hover {
    color: #222;
  }

</style>