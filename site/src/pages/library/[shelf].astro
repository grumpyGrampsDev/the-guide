---
import Layout from "../../layouts/Layout.astro";
import { getGuideShelves, getShelf } from "../../lib/librarian";
import DocumentBody from "../../components/document/DocumentBody.astro";
import Page from "../../components/layout/Page.astro";
import BackLink from "../../components/navigation/BackLink.astro";

export async function getStaticPaths() {
  const availableShelves = await getGuideShelves();

  return availableShelves.map((shelf) => ({
    params: {
      shelf: shelf.slug,
    },
  }));
}

const { shelf: shelfSlug } = Astro.params;

const currentShelf = await getShelf(shelfSlug ?? "");

if (!currentShelf) {
  return Astro.redirect("/404");
}
---

<Layout title={currentShelf.name}>
  <Page>

      <BackLink
        href="/front-desk"
        label="Back to Front Desk"
      />

    {
      currentShelf.readme && (
        <DocumentBody document={currentShelf.readme} />
      )
    }


  </Page>
</Layout>

<style>
  .shelf-header {
    margin-bottom: 2rem;
  }

  .shelf-header a {
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: #666;
  }

  .shelf-header a:hover {
    color: #222;
  }
</style>