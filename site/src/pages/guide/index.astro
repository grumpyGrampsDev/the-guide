---
import { getGuideShelves } from "../../lib/librarian";

const shelves = await getGuideShelves();
---

<h1>The Guide</h1>

<section>
  <h2>Welcome</h2>

  <p>
    The Guide is a companion for reading, studying, praying,
    reflecting, remembering, and walking with Scripture.
  </p>

  <p>
    Explore the shelves below, or begin with the recommended path
    for new readers.
  </p>
</section>

<section>
  <h2>Begin Here</h2>

  <a href="/guide/introduction/path-into-the-guide">
    Enter The Guide
  </a>
</section>

<section>
  <h2>Explore the Shelves</h2>

  {
    shelves.map((shelf) => (
      <article>
        <h3>{shelf.name}</h3>

        <ul>
          {
            shelf.documents.map((document) => (
              <li>
                <a href={`/guide/${document.slug}`}>
                  {document.title}
                </a>
              </li>
            ))
          }
        </ul>
      </article>
    ))
  }
</section>